{
  "name": "@pineagent/harness",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "verify:reference": "npm run build && node --test dist/test/frozen-parity.check.js",
    "verify:freeze": "npm run build && node --test dist/test/freeze-manifest.check.js"
  },
  "devDependencies": { "@types/node": "22.18.6", "typescript": "5.9.2" }
}
