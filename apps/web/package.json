{
  "name": "@pineagent/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n mock,web -c green,blue \"npm:mock\" \"npm:dev:web\"",
    "dev:web": "vite",
    "mock": "tsx watch mock/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "sync-faces": "node scripts/sync-faces.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jose": "^6.2.12",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
