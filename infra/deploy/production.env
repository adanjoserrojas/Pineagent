# Production configuration for services/api and the web build. Nothing here is secret: client ids
# are public (the browser sees the SPA's), and the server's Auth0 key lives only on its data volume.
# Changing a value takes effect on the next ./deploy.sh.

# --- server (services/api) ---
AUTH0_DOMAIN=dev-ui182bvnhoqvfaxv.us.auth0.com
AUTH0_AUDIENCE=https://api.pineagent
# "Pineagent Server" machine-to-machine app (private_key_jwt). Empty = GitHub access off.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_KEY_FILE=/workspaces/.pineagent/auth0-m2m.key
WORKSPACES_ROOT=/workspaces/repos
ALLOWED_ORIGINS=https://api.pineagent.us
# Repositories the server will open (owner/repo, comma-separated).
ALLOWED_REPOS=adanjoserrojas/Pineagent

# --- web build (apps/web) ---
PUBLIC_URL=https://api.pineagent.us
AUTH0_SPA_CLIENT_ID=K3EZpRsqpxb3KLlNbwbrUgnGTD64hEPq
