#!/bin/bash
# First-boot setup for the Pineagent server (Amazon Linux 2023), run by cloud-init as root.
# Terraform fills in $${...} placeholders; plain $VAR is bash. Output goes to
# /var/log/pineagent-bootstrap.log, the first place to look when something is missing.
set -euo pipefail
exec > >(tee -a /var/log/pineagent-bootstrap.log) 2>&1
echo "bootstrap start $(date -Is)"

dnf install -y git docker xz tar

# --- Node.js 22 LTS from nodejs.org, checked against the published SHA-256 ---------------------
NODE_BASE=https://nodejs.org/dist/latest-v22.x
cd /tmp
curl -fsSL "$NODE_BASE/SHASUMS256.txt" -o SHASUMS256.txt
NODE_TAR=$(awk '/linux-x64\.tar\.xz$/ {print $2}' SHASUMS256.txt)
curl -fsSLO "$NODE_BASE/$NODE_TAR"
grep " $NODE_TAR\$" SHASUMS256.txt | sha256sum -c -
tar -xJf "$NODE_TAR" -C /usr/local --strip-components=1
node --version

# --- Docker (per-user containers come in phase 4) ---------------------------------------------
systemctl enable --now docker

# --- The service account: the server runs as this user, never as root -------------------------
id pineagent >/dev/null 2>&1 || useradd --system --create-home --shell /sbin/nologin pineagent

# --- Data volume at /workspaces ---------------------------------------------------------------
# Nitro instances show EBS volumes as NVMe disks with unpredictable names (/dev/nvme1n1 ...), so
# find ours by its volume ID. The attachment can land a little after boot, hence the wait.
DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(data_volume_id, "-", "")}"
for _ in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 5; done
[ -e "$DEV" ] || { echo "data volume never appeared"; exit 1; }
# Format only a blank disk. On a rebuilt instance the volume already has the repos on it.
blkid "$DEV" >/dev/null || mkfs.xfs "$DEV"
UUID=$(blkid -s UUID -o value "$DEV")
mkdir -p /workspaces
# nofail: if the volume is ever missing, the machine still boots and you can get in to fix it.
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /workspaces xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
chown pineagent:pineagent /workspaces

# --- Placeholder until the real server is deployed (phase 3) ----------------------------------
# Answers /health so the infrastructure can be tested on its own. Localhost only: from outside,
# everything goes through Caddy.
# The code lives in its own file: systemd rewrites escapes like \n inside ExecStart= lines.
mkdir -p /opt/pineagent
cat > /opt/pineagent/placeholder.js <<'JS'
require("http")
  .createServer((req, res) => {
    const ok = req.url === "/health";
    res.writeHead(ok ? 200 : 404, { "content-type": "text/plain" });
    res.end(ok ? "ok (placeholder)\n" : "not found\n");
  })
  .listen(3001, "127.0.0.1");
JS
cat > /etc/systemd/system/pineagent-placeholder.service <<'UNIT'
[Unit]
Description=Pineagent placeholder health endpoint
After=network-online.target

[Service]
User=pineagent
ExecStart=/usr/local/bin/node /opt/pineagent/placeholder.js
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now pineagent-placeholder
%{ if domain_name != "" ~}

# --- Caddy: HTTPS for ${domain_name} ---------------------------------------------------------
# Terminates TLS with a Let's Encrypt certificate it obtains and renews itself, redirects http to
# https, and proxies everything (WebSockets included) to the Node server on localhost.
CADDY_TAR=caddy_${caddy_version}_linux_amd64.tar.gz
CADDY_BASE=https://github.com/caddyserver/caddy/releases/download/v${caddy_version}
cd /tmp
curl -fsSLO "$CADDY_BASE/$CADDY_TAR"
curl -fsSLO "$CADDY_BASE/caddy_${caddy_version}_checksums.txt"
sha512sum -c --ignore-missing "caddy_${caddy_version}_checksums.txt"
tar -xzf "$CADDY_TAR" -C /usr/local/bin caddy
caddy version

id caddy >/dev/null 2>&1 || useradd --system --home-dir /var/lib/caddy --create-home --shell /sbin/nologin caddy
# Certificates live on the data volume, so a rebuilt instance reuses them instead of asking
# Let's Encrypt again (it allows only 5 identical certificates a week).
install -d -o caddy -g caddy -m 700 /workspaces/.caddy
mkdir -p /etc/caddy
cat > /etc/caddy/Caddyfile <<'CADDY'
${domain_name} {
	encode
	reverse_proxy 127.0.0.1:3001
}
CADDY

cat > /etc/systemd/system/caddy.service <<'UNIT'
[Unit]
Description=Caddy (HTTPS for Pineagent)
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/workspaces/.caddy XDG_CONFIG_HOME=/var/lib/caddy/config
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
# Binding ports 80 and 443 normally needs root; this grants just that one ability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now caddy
%{ endif ~}

echo "bootstrap done $(date -Is)"
