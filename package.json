{
  "name": "pineagent",
  "private": true,
  "description": "npm workspaces: run `npm ci` here once; each package keeps its own scripts.",
  "workspaces": [
    "packages/core",
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
